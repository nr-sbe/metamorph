    "build:pages": "tsc --noEmit && vite build --base=/metamorph/"
  },
  "dependencies": {
    "@babylonjs/core": "^8.0.0",
    "@babylonjs/loaders": "8.56.2",
    "@dimforge/rapier3d-compat": "^0.17.3"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  }
}
